#! /usr/bin/env bash

mode="full-remote"
cdef="./cdef.json"
config="./auditree.template.json"

usage="
$0: Run evidence fetchers

Usage:
  $0 -h
  $0 [-c CDEF] [-t AUDITREE_CONFIG] [-m MODE]

Options:
-h: show help and exit
-c CDEF: OSCAL component definition file to use for building auditree config. Defaults to $cdef
-t AUDITREE_CONFIG: auditree template config file. Will be used as entire config if -c file is missing. Defaults to $config
-m MODE: Auditree operation mode. One of: local, no-push, full-remote. Defaults to $mode
"

set -e

while getopts "hc:t:m:" opt; do
  case "$opt" in
    c)
      cdef=${OPTARG}
      ;;
    t)
      config=${OPTARG}
      ;;
    m)
      mode=${OPTARG}
      ;;
    h)
      echo "$usage"
      exit 0
      ;;
  esac
done

if [ -f "$cdef" ]; then
  python c2p/compliance_to_policy.py -c "$cdef" -t "$config" -o auditree/auditree.json
else
  cp "$config" auditree/auditree.json
fi

cf auth

cd auditree

compliance --fetch -C auditree.json -v --evidence "$mode"
